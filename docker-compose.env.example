# docker-compose.env.example
# Copy this to .env in the SwarmTrace/ root folder before running docker compose up
#
# cp docker-compose.env.example .env

# Required: Get your free API key at https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# Required: Change this to any random string of 32+ characters
JWT_SECRET_KEY=change-me-to-a-random-string-minimum-32-characters